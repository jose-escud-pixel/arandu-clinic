      "patient_avatars": [
        "https://images.unsplash.com/photo-1671718648167-6b209c182480?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDQ2NDJ8MHwxfHNlYXJjaHwzfHxkaXZlcnNlJTIwcGF0aWVudHMlMjBwb3J0cmFpdHMlMjBzbWlsaW5nfGVufDB8fHx8MTc3MzU3OTAwNnww&ixlib=rb-4.1.0&q=85",
        "https://images.unsplash.com/photo-1752084794888-0b27a762b6fd?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDQ2NDJ8MHwxfHNlYXJjaHwxfHxkaXZlcnNlJTIwcGF0aWVudHMlMjBwb3J0cmFpdHMlMjBzbWlsaW5nfGVufDB8fHx8MTc3MzU3OTAwNnww&ixlib=rb-4.1.0&q=85",
        "https://images.unsplash.com/photo-1658288098101-84f074c292a8?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDQ2NDJ8MHwxfHNlYXJjaHwyfHxkaXZlcnNlJTIwcGF0aWVudHMlMjBwb3J0cmFpdHMlMjBzbWlsaW5nfGVufDB8fHx8MTc3MzU3OTAwNnww&ixlib=rb-4.1.0&q=85"
      ],
      "xrays": [
        "https://images.unsplash.com/photo-1748712308129-1d200044113d?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA0MTJ8MHwxfHNlYXJjaHwxfHx4cmF5JTIwYm9uZXMlMjBtZWRpY2FsJTIwc2NhbnxlbnwwfHx8fDE3NzM1NzkwMDV8MA&ixlib=rb-4.1.0&q=85",
        "https://images.unsplash.com/photo-1648025487735-2ca48d72c449?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA0MTJ8MHwxfHNlYXJjaHwzfHx4cmF5JTIwYm9uZXMlMjBtZWRpY2FsJTIwc2NhbnxlbnwwfHx8fDE3NzM1NzkwMDV8MA&ixlib=rb-4.1.0&q=85",
        "https://images.unsplash.com/photo-1650562373852-04c5682ec2e7?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA0MTJ8MHwxfHNlYXJjaHwyfHx4cmF5JTIwYm9uZXMlMjBtZWRpY2FsJTIwc2NhbnxlbnwwfHx8fDE3NzM1NzkwMDV8MA&ixlib=rb-4.1.0&q=85"
      ]
    },
    "icons": "Use 'Lucide-React'. Preferred icons: Activity, Bone, Calendar, User, FileText, ClipboardList."
  },
  "instructions_to_main_agent": [
    "INSTALL FONTS: Add '@fontsource/manrope' and '@fontsource/inter' immediately.",
    "THEME SETUP: Configure tailwind.config.js with the provided 'Healing Clay' and 'Bone' colors. Do NOT use the default shadcn slate/zinc colors.",
    "COMPONENT OVERRIDE: Modify Shadcn components to use 'rounded-2xl' and 'rounded-full'. Avoid sharp edges.",
    "LAYOUT: Use the 'Bento Grid' strategy for the dashboard. Do not create a generic list view.",
    "ACCESSIBILITY: Ensure text contrast on the 'Healing Clay' buttons is sufficient (use white text).",
    "DATA-TESTID: Add 'data-testid' to all interactive elements (buttons, inputs, cards).",
    "NO GRADIENTS: Stick to solid, warm, earthy tones.",
    "GLASSMORPHISM: Use subtle glass effects (bg-white/70 backdrop-blur-md) only for sticky headers, not for content cards."
  ],
  "universal_guidelines": [
    "Do not use generic centered layouts.",
    "Create depth through layered design elements.",
    "Every interaction needs micro-animations.",
    "Use 2-3x more spacing than feels comfortable.",
    "Add data-testid to all interactive elements."
  ]
}